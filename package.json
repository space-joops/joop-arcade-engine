{
  "name": "joop-arcade-engine",
  "version": "0.1.0",
  "description": "우주 쓰레기 수거 아케이드 게임 엔진 — 관성 물리 · 5원 조이스틱 · React 컴포넌트",
  "keywords": [
    "game",
    "arcade",
    "react",
    "canvas",
    "space",
    "physics"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/space-joops/joop-arcade-engine"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src demo",
    "format": "prettier --write ."
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "prettier": "^3",
    "react": "^19",
    "react-dom": "^19",
    "tsup": "^8",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vite": "^7",
    "vitest": "^3"
  },
  "engines": {
    "node": ">=20"
  }
}
